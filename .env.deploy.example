# Copy to .env.deploy (gitignored) for scripts/deploy.mjs
SFTP_HOST=example.com
SFTP_PORT=22
SFTP_USER=you
# the private key file
SFTP_KEY=C:/Users/you/.ssh/id_ed25519
# only if the key has one
SFTP_PASSPHRASE=
# the folder on the server the API runs from: app.js and the rest of dist's
# contents, with its own .env and node_modules
SFTP_ROOT=/path/to/api
# the pm2 process running it (see `pm2 list` on the server)
PM2_NAME=
